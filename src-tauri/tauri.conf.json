{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Timetable Desktop",
  "version": "1.3.0",
  "identifier": "com.delta.timetable",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Timetable Desktop - Suivi d'horaires",
        "width": 1440,
        "height": 960,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "Copyright (c) 2025 Delta. Tous droits réservés.",
    "shortDescription": "Application de suivi et calcul des heures de travail hebdomadaires.",
    "longDescription": "Timetable Desktop est une application Windows pour le suivi et le calcul des heures de travail hebdomadaires. Simplifiez la gestion de votre temps de travail avec calcul automatique des heures supplémentaires, seuils configurables et historique complet.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["nsis", "msi", "appimage", "dmg"],
    "publisher": "Delta",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "tsp": false,
      "wix": {
        "language": "fr-FR"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {}
}
